<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>pl.szczurradar</groupId>
	<artifactId>szczur-radar-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>szczur-radar-api</name>
	<description>Szczur Radar backend API (Spring Boot)</description>

	<properties>
		<java.version>25</java.version>
		<!-- Not managed by the Spring Boot BOM; required by Argon2PasswordEncoder. -->
		<bouncycastle.version>1.86</bouncycastle.version>
		<embabel-agent.version>1.5.2</embabel-agent.version>
		<!-- The Spring AI line Embabel 1.5.2 depends on; keep in step when upgrading Embabel. -->
		<spring-ai.version>2.0.1</spring-ai.version>
		<!-- The version Spring AI 2.0.1 brings (Jackson 3); the assessor validates model output with it. -->
		<json-schema-validator.version>3.0.1</json-schema-validator.version>
		<!-- JUnit tags of the unit test run: everything except live LLM/API runs (profile measurement). -->
		<surefire.groups></surefire.groups>
		<surefire.excludedGroups>measurement</surefire.excludedGroups>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.embabel.agent</groupId>
				<artifactId>embabel-agent-dependencies</artifactId>
				<version>${embabel-agent.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- JPA (Hibernate) over the Flyway-owned schema; also brings JDBC (JdbcClient for the
		     advisory lock, JdbcTemplate for the readiness probe). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Spring Session JDBC with Boot's spring-boot-session module: without that module Boot 4
		     ignores the session cookie settings (spring-session issue #3622). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>${bouncycastle.version}</version>
		</dependency>
		<!-- Embabel agent platform (F-02 builds on it) with the three supported LLM providers; one is
		     active per run, chosen by LLM_API_PROVIDER (llm/LlmProviderProperties). -->
		<dependency>
			<groupId>com.embabel.agent</groupId>
			<artifactId>embabel-agent-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>com.embabel.agent</groupId>
			<artifactId>embabel-agent-starter-google-genai</artifactId>
		</dependency>
		<dependency>
			<groupId>com.embabel.agent</groupId>
			<artifactId>embabel-agent-starter-deepseek</artifactId>
		</dependency>
		<dependency>
			<groupId>com.embabel.agent</groupId>
			<artifactId>embabel-agent-starter-openai-custom</artifactId>
			<!-- Not in the embabel-agent-dependencies BOM. -->
			<version>${embabel-agent.version}</version>
		</dependency>
		<!-- Spring AI's ChatClientAutoConfiguration (pulled in by Embabel) references the tool-calling
		     auto-configuration; without this module every start logs a TypeNotPresentException. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-autoconfigure-model-tool</artifactId>
			<version>${spring-ai.version}</version>
		</dependency>
		<!-- JSON Schema validation of raw model output (agents/assessor/validation/OutputParser). -->
		<dependency>
			<groupId>com.networknt</groupId>
			<artifactId>json-schema-validator</artifactId>
			<version>${json-schema-validator.version}</version>
		</dependency>

		<!-- Test: JUnit, AssertJ, Mockito and MockMvcTester come with the webmvc test starter. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Fixed artifact path for the Dockerfile ENTRYPOINT and the Railway pre-deploy: target/szczur-radar-api.jar -->
		<finalName>szczur-radar-api</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Unit tests: *Test (no Spring context, no Docker). Tests tagged `measurement` call real
			     LLM/source APIs and run only in the `measurement` profile, never in CI. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
					</includes>
					<groups>${surefire.groups}</groups>
					<excludedGroups>${surefire.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
			<!-- Integration tests: *IT (Spring + Testcontainers Postgres). Docker is required:
			     a missing Docker daemon fails `verify` instead of skipping the tests. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Live runs against real APIs with keys from the shell (src/test/java/.../measurement/README.md):
		     ./mvnw -Pmeasurement test -Dtest=<Class>. Only tests tagged `measurement`; no Spring, no Docker. -->
		<profile>
			<id>measurement</id>
			<properties>
				<surefire.groups>measurement</surefire.groups>
				<surefire.excludedGroups></surefire.excludedGroups>
			</properties>
		</profile>
	</profiles>

</project>
